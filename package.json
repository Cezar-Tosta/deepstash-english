{
  "name": "deepstash-english",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "description": "English Study System — um texto por dia, nas quatro habilidades",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e --emptyOutDir",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@supabase/supabase-js": "2.117.3",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
