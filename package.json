  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
